{
  "name": "beyondlenses.github.io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A personal travel photo journal, built for GitHub Pages.",
  "engines": { "node": ">=18" },
  "scripts": {
    "dev": "node scripts/serve.mjs --watch",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test",
    "photos:plan": "node scripts/upload-photos.mjs --plan",
    "photos:upload": "node scripts/upload-photos.mjs",
    "photos:check": "node scripts/upload-photos.mjs --check"
  }
}
